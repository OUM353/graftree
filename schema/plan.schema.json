{
  "$id": "https://github.com/oum353/agent-tree/schema/plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tier": {
      "type": "string",
      "enum": [
        "focused",
        "standard",
        "deep"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "default": "",
      "type": "string"
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "parent": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "leaf",
              "split"
            ]
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "default": {},
            "type": "object",
            "properties": {
              "exposes": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "consumes": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "ownedPaths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sharedPaths": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "object",
            "properties": {
              "files": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "rubric": {
                "type": "string"
              }
            },
            "required": [
              "command"
            ]
          },
          "dependsOn": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            }
          }
        },
        "required": [
          "id",
          "parent",
          "kind",
          "goal",
          "ownedPaths",
          "acceptance"
        ]
      }
    }
  },
  "required": [
    "tier",
    "summary",
    "nodes"
  ]
}
